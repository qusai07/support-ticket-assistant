# --- LLM (local, via Ollama) ---
OLLAMA_HOST=http://localhost:11434
TRIAGE_MODEL=qwen2.5:3b
AGENT_MODEL=qwen2.5:7b
JUDGE_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.0

# --- Routing / HITL thresholds ---
REFUND_ESCALATION_THRESHOLD=200
AUTO_SEND_CONFIDENCE=0.85
VERY_NEGATIVE_SENTIMENT=-0.7

# --- Auth (CHANGE for any shared deployment) ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
ENVIRONMENT=dev
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DEMO_PASSWORD=Lumora-demo-2026

# --- Embeddings ---
EMBEDDING_MODEL=bge-m3

# --- Storage ---
# Local dev uses SQLite; docker compose uses Postgres:
#   DATABASE_URL=postgresql+psycopg://lumora:lumora-dev@localhost:5432/lumora
DATABASE_URL=sqlite:///./storage/app.db
CHROMA_DIR=./storage/chroma
